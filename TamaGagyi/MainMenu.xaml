        </StackPanel>
        
        <!-- Finances tile -->

        <Label Grid.Row="0" Grid.Column="8" Grid.RowSpan="5" Grid.ColumnSpan="9" Background="#4a4037" Opacity="1" Style="{StaticResource RoundedLabel}" Margin="60,40,60,60">
        </Label>
        
        <StackPanel Margin="0,55,0,0" Orientation="Vertical" Grid.Row="0" Grid.Column="9" Grid.RowSpan="4" Grid.ColumnSpan="3">

